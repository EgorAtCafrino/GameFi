{
  "name": "cafrino",
  "version": "1.0.0",
  "private": true,
  "description": "Cafrino — Web3 game builder platform",
  "main": "./server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "node scripts/free-ports.js",
    "dev:server": "node server.js",
    "dev:client": "npm run dev --prefix client",
    "start": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2"
  }
}
